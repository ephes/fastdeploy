{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build --base=/static",
    "serve": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "mande": "^2.0.9",
    "pinia": "^3.0.3",
    "uuid": "^13",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.9.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/ui": "^4.1.12",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.1.2"
  },
  "prettier": {
    "vueIndentScriptAndStyle": true
  },
  "overrides": {
    "js-beautify": {
      "glob": "^14.0.4",
      "editorconfig": {
        "minimatch": "^11.0.5"
      }
    }
  }
}
